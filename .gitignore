# ============================================================
# Whitelist ignore: everything is ignored by default, then the
# documents and code are explicitly kept. PDFs are never tracked.
# ============================================================

# Ignore every file and directory, at any depth
*
!*/

# ---- keep documents -----------------------------------------
!*.md
!*.txt

# ---- keep code ----------------------------------------------
!*.js
!*.jsx
!*.mjs
!*.json
!*.css
!*.html
!*.py

# ---- never ignore these housekeeping files ------------------
!.gitignore

# ---- generated outputs (regenerate: node build-textbooks.js) -
textbooks/

# ---- Next.js app artifacts ---------------------------------
site/node_modules/
site/.next/
site/next-env.d.ts

# ---- working/scratch folders, even their whitelisted files ---
.audit-work/
.freebuff/
__pycache__/
